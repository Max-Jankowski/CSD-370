              "z": 4,
              "hasOpenThreats": true,
              "threats": [
                {
                  "status": "Mitigated",
                  "severity": "Low",
                  "modelType": "STRIDE",
                  "title": "SQL injection from unsanitized input",
                  "type": "Tampering",
                  "description": "A bad actor sends a malicious SQL syntax from a user facing input. If the server passes this data (unsanitized)to the database, the attacker can then manipulate to modify, read and delete information.",
                  "mitigation": "Use parameterized queries, and apply allowlist input validation layer to the web server before any data reaches the database layer. As always principle of least priviledge.\n\nhttps://owasp.org/www-community/attacks/SQL_Injection",
                  "threatId": "8b29521a-d2d9-4684-8e7f-956bdfa08fd5",
                  "$$hashKey": "object:127"
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "modelType": "STRIDE",
                  "title": "Data exposure from excess database permissions",
                  "type": "Information disclosure",
                  "mitigation": "You can never go wrong with going with the principle of least privilege, particularly when working with database accounts.",
                  "description": "Pretty straight forward, should the server database account permissions be too broad, a compromised server process may expose some sensitive data.",
                  "threatId": "3c4602e5-75ba-4ba6-817a-b84096849c20",
                  "$$hashKey": "object:133"
                },
                {
                  "status": "Open",
                  "severity": "High",
                  "modelType": "STRIDE",
                  "title": "DDOS attack from Query flooding",
                  "type": "Denial of service",
                  "threatId": "110e64a6-3905-4649-a0f9-748405366d6f",
                  "$$hashKey": "object:156",
                  "description": "the attacker has gained access o the SQL command data flow, or is activly exploiting our web server layer. they are issuing a large volume of tasking queries on our SQL server. This is exhausting the connection pool and server CPUs. This is making our database unavailable for legitimate users and work",
                  "mitigation": "We recommend that we include query rate limiting at the web server level, connection pooling of the database with hard caps and execution limits of queries. \nhttps://www.youtube.com/watch?v=BhvnGJaZCG4"
                }
              ],
              "attrs": {
